{
    "name": "mitchells-monitor",
    "displayName": "Mitchell's Monitor",
    "description": "Monitors the status of GitHub pull requests. Checks for conflicts, status reports, reviews and whether the branch is up to date. Modern fork of 'Pull Request Monitor' by Erich Behrens.",
    "icon": "icon.png",
    "version": "1.0.0",
    "publisher": "commitchell",
    "author": "Mitchell Simpson <hello@commitchell.com>",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/commitchell/mitchells-monitor/issues"
    },
    "homepage": "https://github.com/commitchell/mitchells-monitor#readme",
    "engines": {
        "vscode": "^1.18.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "*",
        "onCommand:mitchells-monitor.setToken",
        "onCommand:mitchells-monitor.start",
        "onCommand:mitchells-monitor.setMode",
        "onCommand:mitchells-monitor.selectRepository",
        "onCommand:mitchells-monitor.enterRepositoryName"
    ],
    "main": "./src/extension",
    "contributes": {
        "commands": [
            {
                "command": "mitchells-monitor.start",
                "title": "Mitchell's Monitor: Start monitoring"
            },
            {
                "command": "mitchells-monitor.stop",
                "title": "Mitchell's Monitor: Stop monitoring"
            },
            {
                "command": "mitchells-monitor.refresh",
                "title": "Mitchell's Monitor: Refresh now"
            },
            {
                "command": "mitchells-monitor.setMode",
                "title": "Mitchell's Monitor: Set mode"
            },
            {
                "command": "mitchells-monitor.selectRepository",
                "title": "Mitchell's Monitor: Select repository"
            },
            {
                "command": "mitchells-monitor.enterRepositoryName",
                "title": "Mitchell's Monitor: Enter repository name"
            },
            {
                "command": "mitchells-monitor.setToken",
                "title": "Mitchell's Monitor: Set GitHub token"
            }
        ],
        "configuration": [
            {
                "title": "GitHub Pull Request Monitor",
                "type": "object",
                "properties": {
                    "mitchells-monitor.refreshInterval": {
                        "description": "Refresh interval in seconds (min. 15)",
                        "type": "number",
                        "default": 300
                    },
                    "mitchells-monitor.showMerged": {
                        "description": "Show merged pull requests",
                        "type": "boolean",
                        "default": false
                    },
                    "mitchells-monitor.showClosed": {
                        "description": "Show closed pull requests",
                        "type": "boolean",
                        "default": false
                    },
                    "mitchells-monitor.autostart": {
                        "description": "Automatically start the extension on startup",
                        "type": "boolean",
                        "default": true
                    },
                    "mitchells-monitor.count": {
                        "description": "Number of pull requests to show",
                        "type": "number",
                        "default": 6
                    },
                    "mitchells-monitor.githubEnterpriseUrl": {
                        "description": "Optionally, you can provide a GitHub Enterprise URL to query (e.g., 'https://github.mycompany.com')",
                        "type": "string",
                        "default": null
                    },
                    "mitchells-monitor.allowUnsafeSSL": {
                        "description": "Stops the extension from verifying certs (turn on if you get an error)",
                        "type": "boolean",
                        "default": false
                    },
                    "mitchells-monitor.titleRegex": {
                        "description": "Regex pattern to extract text from PR titles for display (e.g., '\\b([A-Z][A-Z0-9]+-\\d+)\\b' to extract JIRA ticket IDs). If not set or no match, PR number will be used.",
                        "type": "string",
                        "default": "\\b([A-Z][A-Z0-9]+-\\d+)\\b"
                    }
                }
            }
        ]
    },
    "scripts": {
        "postinstall": "node ./node_modules/vscode/bin/install",
        "test": "node ./node_modules/vscode/bin/test",
        "lint": "eslint src test"
    },
    "devDependencies": {
        "eslint": "^5.0.1",
        "eslint-config-airbnb": "^17.0.0",
        "eslint-config-airbnb-base": "^13.0.0",
        "eslint-plugin-import": "^2.13.0"
    },
    "dependencies": {
        "https": "^1.0.0",
        "isomorphic-fetch": "^2.2.1",
        "vscode": "^1.1.18"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/commitchell/mitchells-monitor.git"
    }
}
